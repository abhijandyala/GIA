# Copy to ../.env for local development.
# Canonical names are uppercase; legacy camel-case names remain compatible.

# Gateway security
GATEWAY_ACCESS_TOKEN=replace-with-a-long-random-development-token
ALLOWED_ORIGINS=
PORT=8787
REQUEST_TIMEOUT_MS=40000
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
STRICT_PROVIDER_ERRORS=1

# Provider credentials (server-side only)
SERPAPI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_RESPONSE_MODEL=gpt-5.4-mini
ELEVENLABS_API_KEY=
GEOAPIFY_API_KEY=
WEATHERAPI_API_KEY=
WEATHERAPI_FORECAST_DAYS_LIMIT=3
TRANSLATION_API_KEY=
TRANSLATION_PROVIDER=google
TRANSLATION_BASE_URL=

# Fixed provider configuration
ELEVENLABS_VOICE_ID=3Drdg7QWqr45nZmYpXRP
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
